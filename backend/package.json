{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend implementation for Zero-to-One Code Generation Pipeline with Flutter UI Generator",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "start": "ts-node server.ts",
    "build": "tsc",
    "test": "ts-node test-code-generation.ts",
    "test:quick": "ts-node test-code-generation.ts --quick",
    "test:full": "ts-node test-code-generation.ts --cleanup",
    "check-state": "ts-node check-state.ts",
    "test:db": "ts-node test-database-validation.ts",
    "test:identity": "ts-node test-identity.ts",
    "test:integration": "ts-node test-complete-integration.ts"
  },
  "keywords": [
    "flutter",
    "code-generation",
    "ai",
    "openrouter",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/google": "^3.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "ai": "^6.0.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
